# =====================================================
#  개발(dev) 설정 견본
#  사용법: 이 파일을 복사해서 application-dev.properties 로 이름을 바꾸고
#          실제 값을 채우기 (application-dev.properties 는 Git에 안 올라감)
# =====================================================

app.base-url=http://localhost:8080

# DB (내 PC의 MySQL)
spring.datasource.url=jdbc:mysql://localhost:3306/suwon_culture_map
spring.datasource.username=root
spring.datasource.password=여기에_비밀번호

# 테이블은 Flyway 가 만들고 바꿈 (db/migration/V*.sql) → JPA 는 검사만. SQL 로그 보기
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=true

# 수원문화재단 API
swcf.api.key.event=여기에_키

# 카카오
kakao.rest-api-key=여기에_키
kakao.client-secret=여기에_키

# 구글
google.client-id=여기에_키
google.client-secret=여기에_키

# 네이버
naver.client-id=여기에_키
naver.client-secret=여기에_키

# 인스타그램 게시물 수집 (선택). 비워 두면 수집하지 않음
#  - user-id: 내 인스타 계정 ID (17841… 숫자, Graph API 탐색기 debug_token 의 granular_scopes → instagram_basic)
instagram.access-token=
instagram.user-id=
