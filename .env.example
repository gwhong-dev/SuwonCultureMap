# docker compose 용 비밀값 견본 — 실제 파일 이름은 .env (Git 제외)
# 보통은 scripts\setup-docker.cmd 가 application-dev.properties 를 보고 자동으로 만들어 줌
APP_BASE_URL=http://localhost:8080
# 운영 서버 전용 (docker-compose.prod.yml, docs/deploy-ec2.md). 예: suwonbible.com
SITE_DOMAIN=
MYSQL_DATABASE=suwon_culture_map
# 컨테이너 MySQL 을 내 PC에 열 포트 (Workbench 접속용). 비워두면 3307
DB_PORT=
# 로그인 쿠키를 HTTPS 전용으로 (기본 true). Safari 등으로 http 로컬 시험할 때만 false
SESSION_COOKIE_SECURE=true
DB_USERNAME=suwon
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
SWCF_API_KEY_EVENT=
KAKAO_REST_API_KEY=
KAKAO_ADMIN_KEY=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
